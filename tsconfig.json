{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "outDir": "dist-types"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts"
  ]
}
