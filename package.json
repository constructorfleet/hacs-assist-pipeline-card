{
  "name": "assist-pipeline-card",
  "version": "0.1.7",
  "description": "A Home Assistant custom card that opens the Assist pipeline text dialog.",
  "type": "module",
  "main": "dist/hacs-assist-pipeline-card.js",
  "files": [
    "dist",
    "hacs.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run test && npm run build",
    "version:check": "node scripts/verify-release-tag.mjs",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "assist",
    "custom-card"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.19",
    "vitest": "^5.0.0"
  }
}
